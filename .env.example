# Copy this file to .env and fill it in. .env is gitignored: never commit it.
# Vite reads it when npm run dev starts (restart after changing it).

# The identity provider (Auth0 for now), the OpenID Connect way (ADR 042).
# The authority is the tenant's address with a trailing slash, such as
# https://sleepers-dev.eu.auth0.com/ ; the client id is the single-page
# application's; the audience is the Sleepers API's identifier (ADR 049).
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=https://api.sleepers.online

# Where the provider sends you back after signing in and out. Leave empty
# to use this page's own address (/callback and /), as in development; a
# deployment sets them at build time (ADR 068).
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=

# The account service (make accounts in sleepers-server).
VITE_ACCOUNTS_URL=http://127.0.0.1:8081

# The game server's WebSocket. Leave empty for ws://<this host>:8080/ws.
VITE_SERVER_URL=

# DEVELOPMENT ONLY: show the name-only development login (ADR 047); the
# game server must run with -dev-tools. Leave empty to hide it.
VITE_DEV_LOGIN=1
